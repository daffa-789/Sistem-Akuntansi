# ===== Finova (Go) =====
# PORT: backend Go memakai port ini. Hindari 5000 bila sudah dipakai aplikasi lain
# (mis. XAMPP/MySQL tooling) — gunakan 5199.
PORT=5199
VITE_PORT=3000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_FILE=./database/finova.sqlite
OPERATOR_NAME=Operator
COMPANY_NAME=PT Finova Akuntansi Indonesia
# STATIC_DIR: isi dengan folder aset bila ingin melayani frontend dari disk
# (mis. STATIC_DIR=./internal/web/dist). Biarkan kosong untuk memakai aset
# yang tertanam di dalam biner.
STATIC_DIR=
