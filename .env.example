# ===== Finova (aplikasi desktop) =====
# PORT: biarkan kosong agar OS memilih port bebas — Finova tidak lagi menempati
# port tetap, jadi tidak bentrok dengan proyek lain. Isi angka hanya bila memang
# perlu port tertentu (mis. 5199). Server selalu bind ke 127.0.0.1 saja.
PORT=
VITE_PORT=
# CLIENT_ORIGIN hanya perlu saat pengembangan bila frontend memanggil API lintas
# asal. Kosongkan: asal loopback selalu diterima.
CLIENT_ORIGIN=
DATABASE_FILE=./database/finova.sqlite
OPERATOR_NAME=Operator
COMPANY_NAME=PT Finova Akuntansi Indonesia
# STATIC_DIR: isi dengan folder aset bila ingin melayani frontend dari disk
# (mis. STATIC_DIR=./internal/web/dist). Biarkan kosong untuk memakai aset
# yang tertanam di dalam biner.
STATIC_DIR=
