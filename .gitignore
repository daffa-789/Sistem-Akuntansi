node_modules/
dist/
dist-server/
bin/
build/bin/
build/windows/installer/tmp/
release/
coverage/
*.log
.env

# Ruang kerja sementara agent (spike, screenshot, skrip uji sekali pakai)
.scratch/

# Basis data lokal (skema SQLite kini ikut version control di internal/db/schema)
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal
database/*.db
database/*.db-shm
database/*.db-wal

# Profil Chromium jendela WebView2 (cache & shader, dibuat otomatis saat -app)
database/webview2/

# Hasil build frontend ditanam ke biner; hanya penanda folder yang di-commit
internal/web/dist/*
!internal/web/dist/.gitkeep
