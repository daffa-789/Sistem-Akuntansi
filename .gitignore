node_modules/
dist/
dist-server/
bin/
build/bin/
build/windows/installer/tmp/
release/
coverage/
*.log
.env

# Ruang kerja sementara agent (spike, screenshot, skrip uji sekali pakai)
.scratch/
.workbuddy-ai/

# Basis data lokal (skema SQLite kini ikut version control di internal/db/schema)
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal
database/*.db
database/*.db-shm
database/*.db-wal
database/*.lock

# Profil peramban jendela WebView2 (cache & shader) — versi Bun memakai
# peramban sistem, entri ini disimpan untuk basis data lama.
database/webview2/

# Hasil build frontend disajikan server Bun dari disk; hanya penanda folder
# yang di-commit.
internal/web/dist/*
!internal/web/dist/.gitkeep
