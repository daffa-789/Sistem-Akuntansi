{
  "name": "finova-akuntansi",
  "private": true,
  "version": "1.0.0",
  "productName": "Finova",
  "description": "Sistem Akuntansi Web Terpadu Indonesia — backend Rust Native (Axum + SQLite) dengan frontend React + Vite",
  "author": "Finova",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "cargo run -- -no-browser",
    "build:client": "vite build && node scripts/keep-dist.mjs",
    "build:server": "node scripts/build-rust.mjs",
    "build": "npm run build:client && npm run build:server",
    "installer": "node scripts/make-installer.mjs",
    "install:native": "powershell -ExecutionPolicy Bypass -File scripts/install-native.ps1",
    "icon:generate": "python scripts/generate_new_icon.py",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "test": "cargo test && vitest run",
    "test:rust": "cargo test",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "deps:audit": "node scripts/audit-deps.mjs --sizes",
    "clean": "node scripts/clean.mjs",
    "db:init": "cargo run -- db:init",
    "db:clean": "cargo run -- db:clean"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
