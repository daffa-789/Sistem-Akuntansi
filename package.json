{
  "name": "finova-akuntansi",
  "private": true,
  "version": "1.0.0",
  "description": "Sistem Akuntansi Web Terpadu Indonesia",
  "author": "Finova",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:frontend": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:better-sqlite3",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:clean": "tsx scripts/clean-database.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "core-js@3.50.0": true
  }
}
