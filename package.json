{
  "name": "finova-akuntansi",
  "private": true,
  "version": "1.0.0",
  "productName": "Finova",
  "description": "Sistem Akuntansi Web Terpadu Indonesia — backend Go (net/http + SQLite) dengan frontend React + Vite",
  "author": "Finova",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "go run ./cmd/finova",
    "build:client": "vite build && node scripts/keep-dist.mjs",
    "build:server": "node scripts/build-go.mjs",
    "build": "npm run build:client && npm run build:server",
    "installer": "node scripts/make-installer.mjs",
    "icon": "go run ./tools/genicon",
    "start": "node scripts/start.mjs",
    "install:go": "go mod download",
    "preview": "vite preview",
    "test": "go test ./... && vitest run",
    "test:go": "go test ./...",
    "test:ui": "vitest run",
    "vet": "go vet ./...",
    "typecheck": "tsc --noEmit",
    "deps:audit": "node scripts/audit-deps.mjs --sizes",
    "clean": "node scripts/clean.mjs",
    "db:init": "go run ./cmd/finova db:init",
    "db:clean": "go run ./cmd/finova db:clean"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
