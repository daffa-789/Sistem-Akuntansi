{
  "name": "finova-akuntansi",
  "private": true,
  "version": "1.0.0",
  "productName": "Finova",
  "description": "Sistem Akuntansi Web Terpadu Indonesia — backend Bun (bun:sqlite) dengan frontend React + Vite, dijalankan di peramban",
  "author": "Finova",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:server": "bun run server/index.ts -no-browser",
    "build:client": "vite build && node scripts/keep-dist.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:server:bundle": "bun build ./server/index.ts --target=bun --outfile dist-server/finova.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "test": "bun test server && bun run test:ui",
    "test:server": "bun test server",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "deps:audit": "node scripts/audit-deps.mjs --sizes",
    "clean": "node scripts/clean.mjs",
    "db:init": "bun run server/index.ts db:init",
    "db:clean": "bun run server/index.ts db:clean"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
